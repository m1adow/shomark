{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/shomark",
    "Audience": "shomark-api",
    "RequireHttpsMetadata": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://client" ]
  },
  "ReverseProxy": {
    "Routes": {
      "campaign-videos": {
        "RouteId": "campaign-videos",
        "ClusterId": "campaign-api",
        "Match": { "Path": "/api/videos/{**catch-all}" }
      },
      "campaign-fragments": {
        "RouteId": "campaign-fragments",
        "ClusterId": "campaign-api",
        "Match": { "Path": "/api/fragments/{**catch-all}" }
      },
      "campaign-campaigns": {
        "RouteId": "campaign-campaigns",
        "ClusterId": "campaign-api",
        "Match": { "Path": "/api/campaigns/{**catch-all}" }
      },
      "social-platforms": {
        "RouteId": "social-platforms",
        "ClusterId": "social-api",
        "Match": { "Path": "/api/platforms/{**catch-all}" }
      },
      "social-oauth": {
        "RouteId": "social-oauth",
        "ClusterId": "social-api",
        "Match": { "Path": "/api/oauth/{**catch-all}" }
      },
      "social-posts": {
        "RouteId": "social-posts",
        "ClusterId": "social-api",
        "Match": { "Path": "/api/posts/{**catch-all}" }
      },
      "social-analytics": {
        "RouteId": "social-analytics",
        "ClusterId": "social-api",
        "Match": { "Path": "/api/analytics/post/{**catch-all}" }
      },
      "analytics-campaigns": {
        "RouteId": "analytics-campaigns",
        "ClusterId": "analytics-api",
        "Match": { "Path": "/api/analytics/campaigns/{**catch-all}" }
      },
      "notifications": {
        "RouteId": "notifications",
        "ClusterId": "notification-api",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "campaign-api": {
        "ClusterId": "campaign-api",
        "Destinations": {
          "campaign-api": { "Address": "http://campaign-api:8080/" }
        }
      },
      "social-api": {
        "ClusterId": "social-api",
        "Destinations": {
          "social-api": { "Address": "http://social-api:8080/" }
        }
      },
      "notification-api": {
        "ClusterId": "notification-api",
        "Destinations": {
          "notification-api": { "Address": "http://notification-api:8080/" }
        }
      },
      "analytics-api": {
        "ClusterId": "analytics-api",
        "Destinations": {
          "analytics-api": { "Address": "http://analytics-api:8080/" }
        }
      }
    }
  }
}
